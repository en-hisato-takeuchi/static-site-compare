---
// 職種カテゴリ別の一覧の2ページ目以降
import type { GetStaticPaths } from 'astro'
import JobListPage from '../../../../components/JobListPage.astro'
import {
  CATEGORY_LABELS,
  type Category,
  PER_PAGE,
  getJobs,
} from '../../../../lib/jobs'

export const getStaticPaths = (async () => {
  const jobs = await getJobs()
  return (Object.keys(CATEGORY_LABELS) as Category[]).flatMap((category) => {
    const categoryJobs = jobs.filter((job) => job.data.category[0] === category)
    const lastPage = Math.ceil(categoryJobs.length / PER_PAGE)
    return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => {
      const page = i + 2
      return {
        params: { category, page: String(page) },
        props: {
          category,
          jobs: categoryJobs.slice((page - 1) * PER_PAGE, page * PER_PAGE),
          totalCount: categoryJobs.length,
          page,
          lastPage,
        },
      }
    })
  })
}) satisfies GetStaticPaths

const { category, jobs, totalCount, page, lastPage } = Astro.props
---

<JobListPage
  category={category}
  jobs={jobs}
  totalCount={totalCount}
  page={page}
  lastPage={lastPage}
/>
