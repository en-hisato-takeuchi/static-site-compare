---
import type { GetStaticPaths } from 'astro'
import JobDetail from '../../../components/JobDetail.astro'
import Layout from '../../../layouts/Layout.astro'
import { getJobs, toDescription } from '../../../lib/jobs'

export const getStaticPaths = (async () => {
  const jobs = await getJobs()
  return jobs.map((job) => ({
    params: { category: job.data.category[0], id: job.id },
    props: { job },
  }))
}) satisfies GetStaticPaths

const { data } = Astro.props.job
---

<Layout
  title={data.title}
  description={toDescription(data.body)}
  ogType="article"
>
  <JobDetail job={data} />
</Layout>
