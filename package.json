{
  "name": "static-site-compare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:jobs": "node spec/cms/generate-jobs.js",
    "build": "pnpm --recursive --filter \"./site-*\" build",
    "serve": "node tools/serve.js",
    "cms": "node spec/cms/server.js",
    "e2e": "playwright test",
    "measure:lighthouse": "node tools/measure/lighthouse.js",
    "measure:size": "node tools/measure/size.js",
    "measure:build": "node tools/measure/build-time.js",
    "measure:deps": "node tools/measure/deps.js",
    "capture": "node tools/capture.js",
    "convert-images": "node tools/convert-images.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
